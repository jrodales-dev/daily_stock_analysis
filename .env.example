# ===================================
# Daily Stock Analysis System - Environment Configuration Template
# Copy this file to .env and fill in the real configuration
# ===================================

# Watchlist (comma-separated, supports A-share, HK, US codes)
# Shanghai: 600xxx, 601xxx, 603xxx
# Shenzhen: 000xxx, 002xxx, 300xxx
STOCK_LIST=600519,300750,002594

# Anspire Open API Keys (supports multiple, comma-separated)
# Get it at: https://open.anspire.cn/?share_code=QFBC0FYC
# Used for LLM and Web Search if other providers are not configured.
ANSPIRE_API_KEYS=

# Data Source Configuration
# Tushare Pro Token (optional, get from https://tushare.pro/weborder/#/login?reg=834638)
TUSHARE_TOKEN=

# TickFlow API Key (optional)
# TICKFLOW_API_KEY=

# AlphaSift Integration (default: false)
ALPHASIFT_ENABLED=false
ALPHASIFT_INSTALL_SPEC=git+https://github.com/ZhuLinsen/alphasift.git@b2ca66dd47001b9a09890cfe21c2b18c7219ccf5

# Finnhub (optional, US stock data source)
# FINNHUB_API_KEY=

# AlphaVantage (optional, US stock data source)
# ALPHAVANTAGE_API_KEY=

# Longbridge OpenAPI (optional, US/HK stock metrics)
# LONGBRIDGE_OAUTH_CLIENT_ID=
# LONGBRIDGE_OAUTH_TOKEN_CACHE_B64=

# Stock index remote autocomplete update
STOCK_INDEX_REMOTE_UPDATE_ENABLED=true

# ===================================
# AI Model Configuration
# ===================================

# --- API Keys (Fill at least one) ---

# Gemini (https://aistudio.google.com)
GEMINI_API_KEY=

# DeepSeek (https://platform.deepseek.com)
# DEEPSEEK_API_KEY=

# AIHubmix (https://aihubmix.com/?aff=CfMq)
# AIHUBMIX_KEY=

# Anthropic Claude (https://console.anthropic.com)
# ANTHROPIC_API_KEY=

# OpenAI / Compatible API
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Ollama Local Model
# OLLAMA_API_BASE=http://localhost:11434
# LITELLM_MODEL=ollama/qwen3:8b

# Sampling Temperature (0.0-2.0, default 0.7)
# LLM_TEMPERATURE=0.7

# --- Multi-Channel Configuration (Optional) ---
# Example: DeepSeek
# LLM_CHANNELS=deepseek
# LLM_DEEPSEEK_PROTOCOL=deepseek
# LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_DEEPSEEK_API_KEY=sk-xxx
# LLM_DEEPSEEK_MODELS=deepseek-v4-flash
# LITELLM_MODEL=deepseek/deepseek-v4-flash

# ===================================
# Search Engine Configuration
# ===================================
# TAVILY_API_KEYS=
# SERPAPI_API_KEYS=
# BRAVE_API_KEYS=
SEARXNG_PUBLIC_INSTANCES_ENABLED=true

# ===================================
# Social Sentiment Intelligence (US stocks only)
# ===================================
# SOCIAL_SENTIMENT_API_KEY=
# SOCIAL_SENTIMENT_API_URL=https://api.adanos.org

# ===================================
# News Freshness & Analysis Filters
# ===================================
# NEWS_STRATEGY_PROFILE=short
# NEWS_MAX_AGE_DAYS=3
# BIAS_THRESHOLD=5.0

# ===================================
# Agent Strategy Dialogue (WebUI /chat)
# ===================================
# AGENT_MODE=true
# AGENT_LITELLM_MODEL=
# AGENT_MAX_STEPS=10
# Built-in strategies: bull_trend, ma_golden_cross, volume_breakout, hot_theme, event_driven, etc.
AGENT_SKILLS=

# ===================================
# Notification Channels
# ===================================
# WECHAT_WEBHOOK_URL=
# FEISHU_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# EMAIL_SENDER=
# EMAIL_PASSWORD=
# EMAIL_RECEIVERS=
# CUSTOM_WEBHOOK_URLS=
# DISCORD_WEBHOOK_URL=
# SLACK_BOT_TOKEN=
# SLACK_CHANNEL_ID=

# ===================================
# Notification Settings
# ===================================
# SINGLE_STOCK_NOTIFY=false
# REPORT_TYPE=simple
# REPORT_LANGUAGE=en
# REPORT_SUMMARY_ONLY=false
# REPORT_SHOW_LLM_MODEL=true
# REPORT_RENDERER_ENABLED=false
# REPORT_INTEGRITY_ENABLED=true
# MERGE_EMAIL_NOTIFICATION=false

# ===================================
# App settings
# ===================================
DATABASE_PATH=./data/stock_analysis.db
SQLITE_WAL_ENABLED=true

# Backtest configuration
BACKTEST_ENABLED=true
BACKTEST_EVAL_WINDOW_DAYS=10
BACKTEST_MIN_AGE_DAYS=14

# Schedule configuration
SCHEDULE_ENABLED=false
SCHEDULE_TIME=18:00
SCHEDULE_RUN_IMMEDIATELY=true
RUN_IMMEDIATELY=true
MARKET_REVIEW_ENABLED=true

# Proxy
USE_PROXY=false
PROXY_HOST=127.0.0.1
PROXY_PORT=10809

LOG_DIR=./logs
LOG_LEVEL=INFO
MAX_WORKERS=3
DEBUG=false

# WebUI configuration
WEBUI_ENABLED=false
WEBUI_HOST=127.0.0.1
WEBUI_PORT=8000
WEBUI_AUTO_BUILD=true
ADMIN_AUTH_ENABLED=false

# Data Fetcher Priority Configuration
# EFINANCE_PRIORITY=0
# AKSHARE_PRIORITY=1
# TUSHARE_PRIORITY=2
# PYTDX_PRIORITY=2
# BAOSTOCK_PRIORITY=3
# YFINANCE_PRIORITY=4

ENABLE_REALTIME_QUOTE=true
ENABLE_REALTIME_TECHNICAL_INDICATORS=true
ENABLE_CHIP_DISTRIBUTION=true
ENABLE_FUNDAMENTAL_PIPELINE=true
